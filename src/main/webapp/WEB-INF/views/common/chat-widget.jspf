<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ include file="setting.jsp" %>

<!-- === Floating Button === -->
<%-- <div id="cw-fab" title="챗봇 열기" onclick="cwOpen()">
  <img src="${path}/resources/images/chabot.svg"
     alt="챗봇"
     style="width:32px; height:32px;"/>

</div> --%>

<!-- === Chat Popup === -->
<div id="cw-popup" aria-hidden="true">
	<div id="cw-header">
		<span class="fs-16">도움이 필요하신가요?</span>
		<button type="button" id="cw-close" class="btn" onclick="cwClose()">
			<i class="ico close white"><span>닫기</span></i>
		</button>
	</div>
	
	<!-- 토글 바 -->
	<button id="cw-sugs-toggle" type="button" class="btn cw-toggle" onclick="cwToggleSuggestions()">
		<span class="cw-toggle-title">자주 묻는 질문이에요!</span>
		<span id="cw-toggle-caret" class="cw-caret"><i class="ico accordion"></i></span>
	</button>
	
	<!-- 예시: memberId가 세션에서 JSP EL로 접근된다면 -->
	<button type="button" onclick="checkMyInteractions()">내 약 상호작용 확인</button>
	<script>
	async function checkMyInteractions(){
	  try{
	    const res = await fetch('<c:url value="/chat/check-interactions"/>');
	    const data = await res.json();
	    if (data.error && data.code === 'LOGIN_REQUIRED') {
	      alert('로그인이 필요합니다.');
	      return;
	    }
	    cwAppend('bot', data.summary || '(결과 없음)');
	  }catch(e){
	    cwAppend('system', '(상호작용 확인 실패)');
	  }
	}
	</script>

	

	<!-- 추천 질문 (기본: 닫힘) -->
	<div id="cw-sugs" class="cw-sugs" style="display:none;">로딩 중…</div>

	<!-- 메시지 영역 -->
	<div id="cw-body" class="cw-body"></div>

	<!-- 입력창 -->
	<div id="cw-input">
		<input id="cw-msg" type="text" placeholder="질문을 입력하세요"
			onkeydown="if(event.key==='Enter')cwSend()"/>
		<button type="button" onclick="cwSend()" class="btn blue">보내기</button>
	</div>
</div>

<script>
  let cwBusy=false;
  let cwGreeted=false; // 인사말 1회만

  function cwOpen(){
    const p = document.getElementById('cw-popup');
    p.style.display = 'flex';
    p.style.flexDirection = 'column';
    p.setAttribute('aria-hidden','false');

    // 인사말 1회
    if(!cwGreeted){
      cwAppend('bot', '안녕하세요 챗봇 AI 입니다! 무엇이 궁금하실까요?');
      cwGreeted = true;
    }

    // 기본: 닫힘 상태 유지
    const sugs = document.getElementById('cw-sugs');
    sugs.style.display = 'none';
    const caret = document.getElementById('cw-toggle-caret');
    if (caret) caret.classList.remove('open');

    setTimeout(()=>{
      const input = document.getElementById('cw-msg');
      if (input) input.focus();
      cwScrollBottom();
    },0);
  }

  function cwClose(){
    const p = document.getElementById('cw-popup');
    p.style.display = 'none';
    p.setAttribute('aria-hidden','true');
  }

  // 토글(펼치기/접기)
  async function cwToggleSuggestions(){
    const sugs = document.getElementById('cw-sugs');
    const caret = document.getElementById('cw-toggle-caret');
    if (sugs.style.display === 'none') {
      sugs.style.display = 'block';
      if (caret) caret.classList.add('open');
      cwLoadSuggestions(50); // 펼칠 때 넉넉히 로드
    } else {
      sugs.style.display = 'none';
      if (caret) caret.classList.remove('open');
    }
  }

  // 추천 질문 로드 (limit 파라미터)
  async function cwLoadSuggestions(limit=6){
    const box = document.getElementById('cw-sugs');
    try{
      const base = '<c:url value="/chat/suggestions"/>';
      const res = await fetch(base + '?limit=' + encodeURIComponent(limit), {
        headers:{'Accept':'application/json; charset=UTF-8'}
      });
      const data = await res.json();
      box.innerHTML = '';
      (data.items || []).forEach(title=>{
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = title;
        b.onclick = ()=>{ document.getElementById('cw-msg').value = title; cwSend(); };
        box.appendChild(b);
      });
      if ((data.items||[]).length === 0) box.textContent = '(추천 없음)';
    }catch(e){
      box.textContent = '(추천 로딩 실패)';
    }
  }

  async function cwSend(){
    if(cwBusy) return;
    const input = document.getElementById('cw-msg');
    const q = input.value.trim();
    if(!q) return;

    cwBusy = true;
    cwAppend('me', q);
    input.value = '';
    cwTyping(true);

    try{
      const res = await fetch('<c:url value="/chat/api"/>', {
        method:'POST',
        headers:{'Content-Type':'application/json; charset=UTF-8', 'Accept':'application/json; charset=UTF-8'},
        body: JSON.stringify({ message: q })
      });
      const data = await res.json();
      cwTyping(false);
      cwAppend('bot', data.reply || '(응답 없음)');
      cwScrollBottom();
    }catch(e){
      cwTyping(false);
      cwAppend('system', '(네트워크 오류)');
      cwScrollBottom();
    }finally{
      cwBusy = false;
    }
  }

  async function cwReset(){
    await fetch('<c:url value="/chat/reset"/>', {method:'POST'});
    const body = document.getElementById('cw-body');
    body.textContent = '';
    cwAppend('system','대화를 새로 시작합니다.');
  }

  function cwAppend(who, text){
    const body = document.getElementById('cw-body');

    const div = document.createElement('div');
    if (who === '나' || who === 'me') {
      div.className = 'cw-msg user';
      div.textContent = '[나] ' + text;
    } else if (who === '봇' || who === 'bot') {
      div.className = 'cw-msg bot';
      div.textContent = '[봇] ' + text;
    } else {
      div.className = 'cw-msg system';
      div.textContent = '[시스템] ' + text;
    }

    body.appendChild(div);
    cwScrollBottom();
  }

  function cwTyping(on){
    const body = document.getElementById('cw-body');
    if(on){
      const t = document.createElement('div');
      t.id = 'cw-typing';
      t.className = 'cw-msg system';
      t.textContent = '…응답 작성 중…';
      body.appendChild(t);
      cwScrollBottom();
    }else{
      const t = document.getElementById('cw-typing');
      if(t) t.remove();
    }
  }

  function cwScrollBottom(){
    const body = document.getElementById('cw-body');
    body.scrollTop = body.scrollHeight;
  }
</script>
